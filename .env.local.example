DATABASE_URL=postgresql://user:password@localhost:5432/novelbase
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Redis (optional — app works without it, using in-memory fallback)
REDIS_URL=redis://localhost:6379

# Cloudflare R2 (optional — falls back to local file system if not set)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=novelbase
R2_PUBLIC_URL=https://cdn.yourdomain.com
